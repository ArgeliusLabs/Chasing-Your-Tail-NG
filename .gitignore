# Keep captures, credentials, generated files, and local lists out of commits.
# Carries forward the focused artifact-ignore requirement from community PR #8.
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example
.envrc
.idea/
.vscode/
env/
ENV/
env.bak/
venv.bak/
*.kismet
*.kismet-*
*.pcap
*.pcapng
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
wigle_credentials*
ignore_mac_list.json
ignore_ssid_list.json
ignore_lists/*.json
ignore_lists/*.py
# Preserve legacy directory placeholders, while excluding generated content.
kml_files/*
!kml_files/gitkeep.keep
logs/*
!logs/gitkeep.keep
analysis_logs/*
!analysis_logs/gitkeep.keep
reports/*
!reports/gitkeep.keep
surveillance_reports/*
!surveillance_reports/gitkeep.keep
secure_credentials/*
!secure_credentials/gitkeep.keep
demo-observations*.jsonl
.DS_Store
Thumbs.db
.review-data/
