# Example environment variables for Chasing Your Tail (CYT)
# Copy to .env and customize for your environment, or export variables in your shell.

# Master password used to encrypt/decrypt stored credentials
CYT_MASTER_PASSWORD=your-master-password-here

# Set to true to enable non-interactive test mode (not for production)
CYT_TEST_MODE=false

# Optional WiGLE token (migration moves tokens into secure storage)
WIGLE_API_TOKEN=your-wigle-api-token-here

# Optional overrides
KISMET_DB_PATH=/path/to/kismet/*.kismet
LOG_DIR=./logs
